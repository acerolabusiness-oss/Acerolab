# ── esteira de produção ─────────────────────────────────────────
ANTHROPIC_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=

# ── identidade (Supabase) ───────────────────────────────────────
# Sem estas, a plataforma usa o login local (e-mail e senha guardados
# aqui mesmo) e o botão do Google não aparece. Com elas, o Supabase
# passa a ser quem guarda a credencial.
#
# No painel do Supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
#
# Para o botão do Google funcionar, ligue também:
#   Authentication → Providers → Google
# e cadastre esta URL de retorno no Google Cloud:
#   https://SEU-PROJETO.supabase.co/auth/v1/callback

# ── login Google direto (opcional) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── cobrança recorrente ───────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# ── produção e persistência ─────────────────────────────────
# URL canônica HTTPS usada para cookies e proteção de origem.
PUBLIC_URL=
# No Railway, monte um volume persistente neste caminho.
ACEROLAB_DATA_DIR=
# IPs de proxies confiáveis. O padrão seguro é apenas localhost.
FORWARDED_ALLOW_IPS=127.0.0.1
# Somente desenvolvimento: permite testar sem assinatura Stripe.
ACEROLAB_ALLOW_UNPAID=0

# Admins separados por vírgula.
ADMIN_EMAILS=
